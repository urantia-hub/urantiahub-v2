# The origin for canonical URLs and the sitemap. No trailing slash.
SITE_ORIGIN=http://localhost:3000
# "on" lets search engines index the site. Any other value blocks them.
SITE_INDEXABLE=
# Optional. Points the content gateway at another API host (e2e uses this).
URANTIA_API_BASE_URL=
# Optional. Comma list of paper ids to build ahead of time. Empty means all 197.
PRERENDER_PAPERS=
REVALIDATE_SECRET=
INDEXNOW_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

{
  "ci": {
    "collect": {
      "startServerCommand": "SITE_INDEXABLE=on bash e2e/serve.sh",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 300000,
      "url": ["http://localhost:3100/", "http://localhost:3100/papers/paper-1-the-universal-father"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:accessibility": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
